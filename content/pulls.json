{
  "$schema": "https://json.swell.store/content.json",
  "collection": "pulls",
  "label": "Airtable edits",
  "description": "Each record is one check that found edits in Airtable, with what was written back to Swell",
  "fields": [
    {
      "id": "table",
      "label": "Table",
      "type": "select",
      "readonly": true,
      "options": [
        {
          "value": "products",
          "label": "Products"
        },
        {
          "value": "variants",
          "label": "Product variants"
        },
        {
          "value": "accounts",
          "label": "Customers"
        },
        {
          "value": "coupons",
          "label": "Coupons"
        },
        {
          "value": "categories",
          "label": "Categories"
        }
      ]
    },
    {
      "id": "status",
      "label": "Status",
      "type": "select",
      "readonly": true,
      "options": [
        {
          "value": "running",
          "label": "Running"
        },
        {
          "value": "completed",
          "label": "Completed"
        }
      ]
    },
    {
      "id": "found",
      "label": "Edited records",
      "type": "number",
      "readonly": true
    },
    {
      "id": "changed",
      "label": "Updated in Swell",
      "type": "number",
      "readonly": true
    },
    {
      "id": "failed",
      "label": "Edits rejected",
      "type": "number",
      "readonly": true
    },
    {
      "id": "date_cursor",
      "label": "Read edits made after",
      "type": "date",
      "readonly": true
    },
    {
      "id": "date_pass_started",
      "label": "Started",
      "type": "date",
      "readonly": true
    },
    {
      "id": "date_completed",
      "label": "Finished",
      "type": "date",
      "readonly": true
    },
    {
      "id": "last_error",
      "label": "Last error",
      "type": "long_text",
      "readonly": true
    },
    {
      "id": "date_last_error",
      "label": "Last error at",
      "type": "date",
      "readonly": true
    }
  ],
  "views": [
    {
      "id": "list",
      "nav": {
        "label": "Airtable edits"
      },
      "actions": [
        {
          "id": "hide_actions",
          "link": "#",
          "hidden": true
        }
      ],
      "sort": {
        "date_created": "desc"
      },
      "fields": [
        {
          "id": "table"
        },
        {
          "id": "status"
        },
        {
          "id": "found"
        },
        {
          "id": "changed"
        },
        {
          "id": "failed"
        },
        {
          "id": "date_pass_started"
        },
        {
          "id": "date_completed"
        }
      ],
      "tabs": [
        {
          "id": "failed",
          "label": "With rejected edits",
          "query": {
            "where": {
              "failed": {
                "$gt": 0
              }
            }
          }
        }
      ]
    },
    {
      "id": "edit",
      "title": "Airtable edits: {{ record.table }}",
      "fields": [
        {
          "type": "field_row",
          "fields": [
            {
              "id": "table",
              "admin_span": 2
            },
            {
              "id": "status",
              "admin_span": 2
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "found",
              "admin_span": 1
            },
            {
              "id": "changed",
              "admin_span": 1
            },
            {
              "id": "failed",
              "admin_span": 2
            }
          ]
        },
        {
          "type": "field_row",
          "fields": [
            {
              "id": "date_cursor",
              "admin_span": 2
            },
            {
              "id": "date_pass_started",
              "admin_span": 1
            },
            {
              "id": "date_completed",
              "admin_span": 1
            }
          ]
        },
        {
          "id": "last_error",
          "conditions": {
            "last_error": {
              "$exists": true
            }
          }
        },
        {
          "id": "date_last_error",
          "conditions": {
            "last_error": {
              "$exists": true
            }
          }
        }
      ]
    }
  ]
}
