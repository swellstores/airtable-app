{
  "$schema": "https://json.swell.store/model.json",
  "collection": "syncs",
  "label": "Airtable backfills",
  "description": "Airtable backfills: existing records of one collection sent to Airtable",
  "name_pattern": "{collection}",
  "fields": {
    "collection": {
      "type": "string",
      "enum": [
        "orders",
        "order_items",
        "accounts",
        "products",
        "variants",
        "subscriptions",
        "coupons",
        "categories"
      ],
      "description": "Collection to backfill"
    },
    "status": {
      "type": "string",
      "default": "pending",
      "enum": [
        "pending",
        "running",
        "waiting",
        "completed",
        "failed",
        "canceled"
      ]
    },
    "date_from": {
      "type": "date",
      "description": "Backfill only records created on or after this date"
    },
    "last_id": {
      "type": "string",
      "description": "ID of the last record sent; the next page starts after it"
    },
    "pages": {
      "type": "int",
      "default": 0,
      "description": "Steps run so far"
    },
    "sent": {
      "type": "int",
      "default": 0,
      "description": "Records sent"
    },
    "total": {
      "type": "int",
      "description": "Records to send, counted on the first step"
    },
    "last_error": {
      "type": "string"
    },
    "retries": {
      "type": "int",
      "default": 0,
      "description": "Automatic retries after rate limits or Airtable errors"
    },
    "date_retry": {
      "type": "date",
      "description": "When a waiting job is retried"
    },
    "date_started": {
      "type": "date"
    },
    "date_completed": {
      "type": "date"
    }
  },
  "events": {
    "types": [
      {
        "id": "created"
      },
      {
        "id": "updated"
      },
      {
        "id": "deleted"
      }
    ]
  }
}
